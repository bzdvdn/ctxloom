# Local keys for the demo (loaded via python-dotenv).
# Copy into .env and fill in; .env is in .gitignore.

# --- chat: OpenRouter · DeepSeek (hybrid models run in fast mode) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- chat: OpenAI-compatible generic provider (llm_from_env) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=...
# OPENAI_MODEL=qwen2.5:7b

# Network / auth knobs (optional). Some vendors want a different header or
# prefix than "Authorization: Bearer":
#   OPENROUTER_PROXY=http://proxy.corp:8080
#   OPENROUTER_AUTH_HEADER=X-Api-Key    # default "Authorization"
#   OPENROUTER_AUTH_SCHEME=OAuth        # "Bearer", "OAuth", "api-key", ...
#   OPENROUTER_AUTH_SCHEME=             # empty value = raw key, no prefix
#   OPENAI_PROXY / OPENAI_AUTH_HEADER / OPENAI_AUTH_SCHEME  (same knobs)

# --- embeddings: Mistral ---
EMBEDDER_BASE_URL=https://api.mistral.ai/v1
EMBEDDER_API_KEY=...
EMBEDDER_MODEL=mistral-embed
# EMBEDDER_PROXY=http://proxy.corp:8080
# EMBEDDER_AUTH_HEADER=X-Api-Key
# EMBEDDER_AUTH_SCHEME=

# --- image: OpenRouter (same model as in the examples) ---
IMAGE_API_KEY=sk-or-v1-...
IMAGE_BASE_URL=https://openrouter.ai/api/v1
IMAGE_MODEL=krea/krea-2-medium-turbo
# IMAGE_PROXY=http://proxy.corp:8080
# IMAGE_AUTH_HEADER=X-Api-Key
# IMAGE_AUTH_SCHEME=