# Local keys for the devops demo (loaded via python-dotenv).
# Copy into .env and fill in; .env is in .gitignore.

# --- chat: OpenRouter · DeepSeek (LLM picks the tool) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Network / auth knobs (optional). Some vendors want a different header or
# prefix than "Authorization: Bearer":
#   OPENROUTER_PROXY=http://proxy.corp:8080
#   OPENROUTER_AUTH_HEADER=X-Api-Key    # default "Authorization"
#   OPENROUTER_AUTH_SCHEME=api-key      # "Bearer", "OAuth", "api-key", ...
#   OPENROUTER_AUTH_SCHEME=             # empty value = raw key, no prefix

# Without a key the demo cannot answer; the agents honestly say so.