# Optional model mode for the llm-ladder (levels run fully offline without it).
# Copy to `.env` and set one provider; without it `structured_llm` returns None
# and each level answers with its honest deterministic fallback (§59).

# --- simplest: OpenRouter (multi-vendor) -------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- or any other vendor factory (openai, anthropic, deepseek, groq, ...) ----
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat