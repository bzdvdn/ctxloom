# Local keys for the medic-lab demo (loaded via python-dotenv).
# Copy into .env and fill in; .env is in .gitignore.

# --- chat: OpenRouter · DeepSeek (report / extract generation) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- chat: OpenAI-compatible generic provider (llm_from_env) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=...
# OPENAI_MODEL=qwen2.5:7b

# Network / auth knobs (optional) — same as the other demos:
#   OPENROUTER_PROXY=http://proxy.corp:8080
#   OPENROUTER_AUTH_HEADER=X-Api-Key
#   OPENROUTER_AUTH_SCHEME=api-key

# The lab enables reasoning for OpenRouter hybrid models by default (better
# for evidence analysis). Set to "off" to run fast:
# MEDIC_LAB_REASONING=off

# Optional live-web evidence pages (comma-separated), in addition to the local
# fixtures in examples/medic_lab/pages/:
# MEDIC_LAB_URLS=https://en.wikipedia.org/wiki/Vitamin_D,https://en.wikipedia.org/wiki/Common_cold

# Run-trace dashboard auth (optional; without them /traces is open on localhost):
# TRACE_USER=obs
# TRACE_PASSWORD=secret