# Local keys for the knowledge demo (loaded via python-dotenv).
# Copy into .env and fill in; .env is in .gitignore.

# --- chat: OpenRouter · DeepSeek (answer generation) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Optionally override the defaults:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Without a key the demo runs on deterministic fallbacks (no LLM).