# Local keys for the knowledge demo (loaded via python-dotenv).
# Copy into .env and fill in; .env is in .gitignore.

# --- chat: OpenRouter · DeepSeek (answer generation) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- chat: OpenAI-compatible generic provider (llm_from_env) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=...
# OPENAI_MODEL=qwen2.5:7b

# Network / auth knobs (optional). Some vendors want a different header or
# prefix than "Authorization: Bearer":
#   OPENAI_PROXY=http://proxy.corp:8080
#   OPENAI_AUTH_HEADER=X-Api-Key        # default "Authorization"
#   OPENAI_AUTH_SCHEME=OAuth            # "Bearer", "OAuth", "api-key", ...
#   OPENAI_AUTH_SCHEME=                 # empty value = raw key, no prefix

# Without a key the demo runs on deterministic fallbacks (no LLM).

# --- embeddings: Mistral ---
EMBEDDER_BASE_URL=https://api.mistral.ai/v1
EMBEDDER_API_KEY=...
EMBEDDER_MODEL=mistral-embed
# EMBEDDER_PROXY=http://proxy.corp:8080
# EMBEDDER_AUTH_HEADER=X-Api-Key
# EMBEDDER_AUTH_SCHEME=