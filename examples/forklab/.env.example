# Optional LLM mode for the fork-lab demo (branching is itself deterministic, §67).
# Copy to `.env` and set one provider chain; without it the demo runs fully
# offline with an honest deterministic fallback (§59).

# --- simplest: OpenRouter (multi-vendor) -------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- or any other vendor factory (openai, anthropic, deepseek, groq, ...) ----
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat